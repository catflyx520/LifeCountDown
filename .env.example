# Copy this file to .env and fill it in. .env is not committed.
#
# Everything that starts with EXPO_PUBLIC_ is compiled into the app and the web page,
# where anyone can read it. Never put an AI API key (Gemini, Anthropic, OpenAI) here.

# Firebase web config. Public by design: access is controlled by the Firestore rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Address of the estimate endpoint (api/estimate.mjs), for example
# https://life-count-down.vercel.app/api/estimate
# Leave it empty to use the built-in basic estimate.
EXPO_PUBLIC_ESTIMATE_API_URL=
